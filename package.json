{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "preinstall": "node ./scripts/enforce-pnpm.mjs",
    "dev": "node ./scripts/dev.mjs",
    "watchdog": "corepack pnpm --filter @workspace/scripts run watchdog",
    "perf": "corepack pnpm --filter @workspace/scripts run perf",
    "build": "node ./scripts/build.mjs",
    "build:workspace": "corepack pnpm run typecheck && corepack pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "corepack pnpm run typecheck:libs && corepack pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "concurrently": "^10.0.3",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
