# Core app
APP_URL=http://localhost:3000
# Comma-separated list of additional origins allowed to send credentialed CORS requests.
CORS_ORIGINS=
BASE_PATH=/
PORT=5001
WEB_PORT=3000

# Database
# Use a real runtime secret here. Do not commit your actual password.
# Supabase Session Pooler example:
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres
# Local Postgres example:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/lucky_day_planner
DATABASE_URL=
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000
# Remote database connections always verify TLS certificates and hostnames.
# Use verify-full; insecure/disabled modes are rejected for remote hosts.
PGSSLMODE=
# Optional trusted database root CA PEM (literal \n is supported).
# Supabase: obtain the project's root certificate from Database Settings.
DATABASE_SSL_CA_CERT=

# Role management
# Applies only when creating a new provider identity with a verified email.
# Local signup always creates a normal user; existing roles are managed in-app.
ADMIN_EMAILS=
SUPER_ADMIN_EMAILS=your-email@example.com

# Optional SMTP for password reset emails
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Optional OIDC login
OIDC_CLIENT_ID=
OIDC_ISSUER_URL=https://replit.com/oidc

# Optional direct Google/Kakao OIDC login. Server only; never use VITE_ prefixes.
# APP_URL must be the canonical site origin. Missing settings hide that provider.
# Generate a separate random 32-byte key, hex-encoded (64 hex characters).
SOCIAL_AUTH_COOKIE_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Kakao REST API key and enabled client secret; enable OpenID Connect in Kakao.
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=
# Register exact callbacks in provider console:
# ${APP_URL}/api/auth/social/google/callback
# ${APP_URL}/api/auth/social/kakao/callback

# Backward-compatible legacy OIDC vars
REPL_ID=
ISSUER_URL=

# AI assistant (사주 AI 질문 기능)
# Google AI Studio에서 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 기본 모델은 gemini-3.5-flash-lite이며 필요시 여기서 교체
GEMINI_MODEL=

# Optional 한국천문연구원 공공데이터: 공휴일·24절기
# 공공데이터포털에서 "한국천문연구원_특일 정보" 활용신청 후 받은 일반 인증키(Decoding)를 입력하세요.
# 미설정/장애 시 공휴일은 미제공, 음력·손없는날은 로컬 계산, 절기는 지원 범위에서 제공됩니다.
DATA_GO_KR_SERVICE_KEY=

# Supabase auth
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Optional Toss Payments
# Direct Toss Pay contract (different service from Toss Payments below).
# Server only. sk_test_* in local/test (NODE_ENV != production); sk_live_* in production.
TOSS_PAY_API_KEY=
# Keep sales closed until merchant approval, product review and checkout checks finish.
REPORT_SALES_ENABLED=false
# Separate merchant-review checkout. Test keys only; never grants paid access.
TOSS_PAY_REVIEW_ENABLED=false
TOSS_PAY_REVIEW_API_KEY=
# Independent random 32-byte hex key for the encrypted HttpOnly review cookie.
TOSS_PAY_REVIEW_COOKIE_SECRET=
# APP_URL above must be the trusted public site URL (HTTPS in production).
# Direct Toss Pay takes priority if both provider keys are configured.
# `TOSS_SECRET_KEY` is used by the server-side confirmation API.
# `VITE_TOSS_CLIENT_KEY` is used by the browser checkout flow.
TOSS_SECRET_KEY=
VITE_TOSS_CLIENT_KEY=
# Explicit local/test-only simulation; ignored in production. Defaults to off.
PAYMENT_SIMULATION_ENABLED=false

# 2027 campaign: disabled until sample, delivery and privacy review are complete.
# REPORT_SALES_ENABLED remains the existing global sales switch.
REPORT_2027_SALES_ENABLED=false
# Requires separately reviewed docs/sql/new-year-campaign-visits.sql; no auto DDL.
CAMPAIGN_ANALYTICS_ENABLED=false
# Offline sample preparation only; approved anonymized stored analysis JSON.
REPORT_2027_APPROVED_SAMPLE_JSON=
